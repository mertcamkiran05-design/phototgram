# Memogram Environment Variables
# Copy this to .env.local and fill in your values

# ========== SUPABASE ==========
# Get these from https://supabase.io/dashboard
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here_KEEP_SECRET

# ========== BACKUP ==========
# AWS S3 for daily backups
AWS_BACKUP_BUCKET=memogram-backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========== SECURITY ==========
# Random secret for server operations
ENCRYPTION_SECRET=generate_random_32_char_string

# ========== VERCEL ==========
# Set to 'production' or 'development'
ENVIRONMENT=production

# ========== LOGGING ==========
# Set to 'true' to enable detailed logging
DEBUG_MODE=false

# ========== RATE LIMITING ==========
# Per-guest upload limit (files per minute)
RATE_LIMIT_UPLOADS_PER_MINUTE=10

# ========== FILE LIMITS ==========
# Max file size in MB
MAX_FILE_SIZE_MB=50
# Max files per event
MAX_FILES_PER_EVENT=500
